{
    "name": "communitales/report-parser",
    "description": "A PHP based tool to parse DMARC reports from an IMAP mailbox or from the filesystem, and insert the information into a database. Based on techsneeze/dmarcts-report-parser",
    "type": "project",
    "license": "GPL-3.0-only",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4.1",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "communitales/log": ">=3.2",
        "doctrine/dbal": ">=4.4.4",
        "doctrine/doctrine-bundle": "^3.3.1",
        "doctrine/doctrine-migrations-bundle": "^4.0.0",
        "doctrine/orm": "^3.6.8",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/runtime": "8.1.*",
        "symfony/yaml": "8.1.*",
        "webklex/php-imap": "^6.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.19",
        "phpstan/phpstan": "^2.2.8",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-symfony": "^2.0.20",
        "phpunit/phpunit": ">=12.1.3",
        "rector/rector": "^2.6.2",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix",
        "phpstan": "vendor/bin/phpstan analyse > docs/TODO-phpstan.md",
        "rector": "vendor/bin/rector process",
        "test": "vendor/bin/phpunit",
        "codecheck": [
            "@rector",
            "@php-cs-fixer",
            "@phpstan",
            "@test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
